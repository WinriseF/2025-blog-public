{
	"name": "2025-blog",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.7.0",
	"scripts": {
		"dev": "node --require ./scripts/suppress-baseline-warning.cjs ./node_modules/next/dist/bin/next dev --turbopack -p 2025",
		"predev": "pnpm generate:word-cloud",
		"generate:word-cloud": "node scripts/generate-word-cloud.cjs",
		"prebuild": "pnpm generate:word-cloud",
		"svg": "node scripts/gen-svgs-index.js",
		"build": "node --require ./scripts/suppress-baseline-warning.cjs ./node_modules/next/dist/bin/next build --turbopack",
		"start": "next start -p 2025",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\" \"tests/**/*.{ts,tsx,js,jsx,json}\" \"*.{ts,js,json}\""
	},
